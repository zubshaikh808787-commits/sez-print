{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ],
      "josh-printer": [
        "./modules/josh-printer/src/index.ts"
      ],
      "td404-printer": [
        "./modules/td404-printer/src/index.ts"
      ],
      "tez-printer": [
        "./modules/tez-printer/src/index.ts"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
