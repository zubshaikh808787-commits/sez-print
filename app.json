{
  "expo": {
    "name": "sez-print",
    "slug": "sez-print",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sezprint",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.sezprint.app",
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow Sez Print to convert your speech into label text.",
        "NSMicrophoneUsageDescription": "Allow Sez Print to use the microphone for voice-to-text on labels.",
        "NSBluetoothAlwaysUsageDescription": "Allow Sez Print to connect to your Bluetooth label printer.",
        "NSBluetoothPeripheralUsageDescription": "Allow Sez Print to connect to your Bluetooth label printer."
      }
    },
    "android": {
      "package": "com.sezprint.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": false,
            "enableShrinkResourcesInReleaseBuilds": false
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Sez Print to access your camera to scan label barcodes and QR codes."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Sez Print to access your photos to select label images."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Sez Print to use the microphone for voice-to-text on labels.",
          "speechRecognitionPermission": "Allow Sez Print to convert your speech into label text."
        }
      ],
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "bluetoothAlwaysPermission": "Allow Sez Print to connect to your Bluetooth label printer."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bbcee482-b5c1-4862-bb52-a2b8fcbd4da7"
      }
    },
    "owner": "zub705787s-team"
  }
}
