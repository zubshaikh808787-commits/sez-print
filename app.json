{
  "expo": {
    "name": "sez-print",
    "slug": "sez-print",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sezprint",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Sez Print to access your camera to scan label barcodes and QR codes."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Sez Print to access your photos to select label images."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Sez Print to use the microphone for voice-to-text on labels.",
          "speechRecognitionPermission": "Allow Sez Print to convert your speech into label text."
        }
      ],
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "bluetoothAlwaysPermission": "Allow Sez Print to connect to your Bluetooth label printer."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
