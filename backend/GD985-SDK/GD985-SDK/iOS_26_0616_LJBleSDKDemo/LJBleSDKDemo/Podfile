# 指定平台和版本
platform :ios, '13.0'
use_frameworks!
# 指定项目的目标
target 'LJBleDemo' do
  use_frameworks!
  # 添加依赖库
  pod 'Masonry'
  pod 'MBProgressHUD'
  pod 'AFNetworking'
  pod 'SnapKit'
  
  pod 'TZImagePickerController', '3.8.8'

end

