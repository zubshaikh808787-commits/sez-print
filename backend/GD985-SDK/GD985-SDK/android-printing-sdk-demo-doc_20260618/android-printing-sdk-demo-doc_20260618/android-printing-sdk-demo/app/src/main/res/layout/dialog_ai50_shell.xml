<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_ai50_dialog"
    android:orientation="vertical"
    android:padding="@dimen/ai50_dialog_padding">

    <TextView
        android:id="@+id/tv_dialog_title"
        style="@style/Ai50DialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/tv_dialog_subtitle"
        style="@style/Ai50DialogSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/fl_dialog_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ai50_dialog_section_gap" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ai50_dialog_section_gap"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_dialog_cancel"
            style="@style/Ai50OutlineButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/ai50_dialog_button_height"
            android:layout_weight="1"
            android:text="@string/btn_cancel" />

        <View
            android:layout_width="12dp"
            android:layout_height="1dp" />

        <Button
            android:id="@+id/btn_dialog_confirm"
            style="@style/Ai50PrimaryButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/ai50_dialog_button_height"
            android:layout_weight="1"
            android:text="@string/btn_confirm" />
    </LinearLayout>
</LinearLayout>
