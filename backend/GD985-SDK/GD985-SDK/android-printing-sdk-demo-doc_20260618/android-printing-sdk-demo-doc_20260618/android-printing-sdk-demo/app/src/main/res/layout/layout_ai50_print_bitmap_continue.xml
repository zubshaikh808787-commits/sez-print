<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/Ai50DialogLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/print_dialog_count_label" />

            <EditText
                android:id="@+id/et_content"
                style="@style/Ai50DialogInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ai50_dialog_field_gap"
                android:hint="@string/print_dialog_count_hint"
                android:inputType="number"
                android:maxLength="2"
                android:text="1" />
        </LinearLayout>

        <View
            android:layout_width="12dp"
            android:layout_height="1dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/Ai50DialogLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/print_dialog_width_label" />

            <EditText
                android:id="@+id/et_width"
                style="@style/Ai50DialogInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ai50_dialog_field_gap"
                android:hint="@string/print_dialog_width_hint"
                android:inputType="number"
                android:maxLength="3" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        style="@style/Ai50DialogLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ai50_dialog_section_gap"
        android:text="@string/print_dialog_image_label" />

    <LinearLayout
        android:id="@+id/llayout_select_photo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ai50_dialog_field_gap"
        android:background="@drawable/bg_ai50_device_item"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/tv_photo_path"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="middle"
            android:hint="@string/print_dialog_select_image_hint"
            android:singleLine="true"
            android:textColor="@color/ai50_text_primary"
            android:textColorHint="@color/ai50_text_secondary"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/print_dialog_select_image_arrow"
            android:textColor="@color/ai50_primary"
            android:textSize="18sp" />
    </LinearLayout>
</LinearLayout>
