<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/ai50_primary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@color/ai50_background</item>
    </style>

    <style name="Ai50PrimaryButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_ai50_primary_button</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Ai50OutlineButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_ai50_outline_button</item>
        <item name="android:textColor">@color/ai50_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Ai50Theme" parent="AppTheme">
        <item name="android:statusBarColor">@color/ai50_background</item>
        <item name="android:navigationBarColor">@color/white</item>
    </style>

    <style name="Ai50DialogTheme" parent="Theme.AppCompat.Light.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowMinWidthMajor">88%</item>
        <item name="android:windowMinWidthMinor">88%</item>
    </style>

    <style name="Ai50DialogTitle">
        <item name="android:textColor">@color/ai50_text_primary</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Ai50DialogSubtitle">
        <item name="android:textColor">@color/ai50_text_secondary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="Ai50DialogLabel">
        <item name="android:textColor">@color/ai50_text_secondary</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Ai50DialogInput">
        <item name="android:background">@drawable/bg_ai50_device_item</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textColor">@color/ai50_text_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="Ai50DialogTip">
        <item name="android:background">@drawable/bg_ai50_dialog_tip</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:textColor">@color/ai50_text_secondary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <style name="Ai50DialogWarning">
        <item name="android:background">@drawable/bg_ai50_dialog_warning</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textColor">@color/ai50_dialog_warning_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>

</resources>
